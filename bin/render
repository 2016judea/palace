#!/usr/bin/env python3
"""state/ -> site/index.html. Phone first; one idea per screen; no names of people or companies."""
import json, os, glob, html, re, datetime as dt
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); os.chdir(ROOT)
CFG = json.load(open("palace.json"))
def jl(p): return [json.loads(l) for l in open(p) if l.strip()] if os.path.exists(p) else []
def esc(s): return html.escape(s or "")
now = dt.datetime.now(); day = now.date().isoformat(); yday = (now - dt.timedelta(days=1)).date().isoformat()
rev = sum(float(r["usd"]) for r in jl("state/revenue.jsonl"))
goal = CFG["goal_usd"]; daily = CFG["budget"]["daily_usd"]
spent = sum(float(r["usd"]) for r in jl("state/ledger.jsonl") if r["ts"].startswith(day))
ticks_all = jl("state/ticks.jsonl"); ticks = [t for t in ticks_all if t["ts"].startswith(day)]
last = json.load(open("state/last_tick.json")) if os.path.exists("state/last_tick.json") else {}
floor = 0
while rev >= 10 ** (floor + 1): floor += 1

# lights
age_min = None
if last.get("ts"):
    age_min = (now - dt.datetime.fromisoformat(last["ts"])).total_seconds() / 60
mode = last.get("mode")
if mode == "ascended": light, light_cls = "in heaven", "gold"
elif mode == "dark": light, light_cls = "no wifi · waiting", "dim"
elif mode == "asleep": light, light_cls = f"purse empty · asleep till midnight", "dim"
elif age_min is not None and age_min > 75: light, light_cls = "lid closed · they wake when it opens", "dim"
elif mode in ("worked", "failed", "busy", "dry"): light, light_cls = "green fields · at work", "green"
else: light, light_cls = "not yet woken", "dim"
seen = f"last seen {dt.datetime.fromisoformat(last['ts']).strftime('%-I:%M %p')}" if last.get("ts") else ""

# word
word_raw = open("state/word.md").read() if os.path.exists("state/word.md") else ""
fm, body = {}, word_raw
m = re.match(r"^---\n(.*?)\n---\n(.*)$", word_raw, re.S)
if m:
    for line in m.group(1).splitlines():
        if ":" in line: k, v = line.split(":", 1); fm[k.strip()] = v.strip()
    body = m.group(2)
def md(s):
    out = []
    for para in re.split(r"\n\s*\n", s.strip()):
        p = para.strip()
        if not p: continue
        if p.startswith("## "): out.append(f"<h3>{esc(p[3:])}</h3>"); continue
        if p.startswith("# "): out.append(f"<h3>{esc(p[2:])}</h3>"); continue
        p = esc(p)
        p = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", p); p = re.sub(r"\*(.+?)\*", r"<i>\1</i>", p)
        out.append("<p>" + p.replace("\n", "<br>") + "</p>")
    return "\n".join(out)

# outbox
def fm_of(p):
    t = open(p).read(); d = {}
    m = re.match(r"^---\n(.*?)\n---", t, re.S)
    if m:
        for line in m.group(1).splitlines():
            if ":" in line: k, v = line.split(":", 1); d[k.strip()] = v.strip()
    return d
outbox = []
for p in sorted(glob.glob("state/outbox/*.md")):
    d = fm_of(p); age = (now - dt.datetime.fromtimestamp(os.path.getmtime(p))).days
    outbox.append((d.get("title") or os.path.basename(p)[11:-3].replace("-", " "), d.get("kind", ""), d.get("usd", ""), age, os.path.basename(p)))

paths = json.load(open("paths.json"))["paths"]
floors = [(9, "heaven", "$1B")] + [(n, "", f"${10**n:,.0f}") for n in range(8, 0, -1)] + [(0, "the dungeon", "")]

# journal (today, else yesterday)
jpath = f"journal/{day}.md" if os.path.exists(f"journal/{day}.md") else f"journal/{yday}.md"
journal = open(jpath).read() if os.path.exists(jpath) else ""
jday = os.path.basename(jpath)[:-3] if journal else ""

pct = min(spent / daily, 1.0) * 100
resident_icon = {"god": "☼", "steward": "⚖", "mason": "⚒", "merchant": "⚖", "scout": "⚑"}
resident_icon["steward"] = "☖"

rows = "".join(
    f"<li><span class='t'>{esc(t['ts'][11:16])}</span><span class='r'>{esc(t['resident'])}</span>"
    f"<span class='a'>{esc(t.get('act',''))}</span><span class='c'>${t.get('usd',0):.2f}</span></li>"
    for t in reversed(ticks)) or "<li class='empty'>no one has woken yet today</li>"
ob = "".join(
    f"<li><span class='k {esc(k)}'>{esc(k or 'ask')}</span><span class='a'>{esc(title)}</span>"
    f"<span class='c'>{esc(('$'+str(usd)) if usd else '')}{(' · '+str(age)+'d') if age else ''}</span></li>"
    for title, k, usd, age, _ in outbox) or "<li class='empty'>nothing waits on you</li>"
mp = "".join(
    f"<li><span class='s {esc(p['status'])}'>{esc(p['status'])}</span><span class='a'>{esc(p['name'])}</span><span class='c'>{esc(p['grant'])}</span></li>"
    for p in paths)
stairs = "".join(
    f"<li class='{'here' if n == floor else ''} {'top' if n == 9 else ''}'><span class='n'>{n}</span><span class='l'>{esc(lbl)}</span><span class='v'>{esc(v)}</span></li>"
    for n, lbl, v in floors)

page = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>The Palace</title>
<meta name="description" content="Brick &amp; Mortar, run from the dungeon. Residents work until the ledger reads one billion; then they walk out together.">
<meta name="robots" content="noindex">
<style>
:root{{--bg:#0d0c0a;--stone:#171512;--stone2:#211e1a;--ink:#e9e2d3;--mute:#8d8574;--line:#2c2823;--gold:#d8a94a;--green:#7fc97f;--red:#d76f5a;--dim:#5e574a}}
@media (prefers-color-scheme: light){{:root:not([data-theme="dark"]){{--bg:#f3eee3;--stone:#faf7f0;--stone2:#efe9dc;--ink:#1d1a15;--mute:#6f6756;--line:#ddd5c4;--gold:#9a6f12;--green:#2f7d32;--red:#b6432c;--dim:#a49b88}}}}
*{{box-sizing:border-box}}html{{-webkit-text-size-adjust:100%}}
body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 -apple-system,"SF Pro Text",Inter,system-ui,sans-serif;padding:0 16px 48px;max-width:640px;margin:0 auto;overflow-x:hidden}}
header{{padding:28px 0 8px}}h1{{font:600 13px/1 ui-monospace,Menlo,monospace;letter-spacing:.22em;text-transform:uppercase;color:var(--mute);margin:0}}
.light{{display:flex;align-items:center;gap:10px;margin:14px 0 0;font-size:15px}}.light .dot{{width:10px;height:10px;border-radius:50%;background:var(--dim);box-shadow:0 0 0 3px var(--stone2)}}
.light.green .dot{{background:var(--green);box-shadow:0 0 12px var(--green)}}.light.gold .dot{{background:var(--gold);box-shadow:0 0 12px var(--gold)}}.light .seen{{color:var(--mute);margin-left:auto;font-size:13px}}
section{{margin:26px 0 0}}h2{{font:500 12px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--mute);margin:0 0 10px}}
.num{{font:600 clamp(44px,13vw,72px)/1 -apple-system,"SF Pro Display",Inter,sans-serif;letter-spacing:-.03em;margin:4px 0 2px;font-variant-numeric:tabular-nums}}
.sub{{color:var(--mute);font-size:14px}}
.stairs{{list-style:none;margin:16px 0 0;padding:0;border-left:2px solid var(--line)}}
.stairs li{{display:flex;gap:10px;align-items:center;padding:3px 0 3px 12px;color:var(--dim);font-size:13px;font-variant-numeric:tabular-nums}}
.stairs li .n{{width:1.2em;font-family:ui-monospace,Menlo,monospace}}.stairs li .l{{flex:1}}.stairs li .v{{color:var(--dim)}}
.stairs li.top{{color:var(--gold)}}.stairs li.top .v{{color:var(--gold)}}
.stairs li.here{{color:var(--ink);font-weight:600;position:relative}}.stairs li.here::before{{content:"";position:absolute;left:-7px;top:50%;width:12px;height:12px;border-radius:50%;background:var(--green);transform:translateY(-50%);box-shadow:0 0 10px var(--green)}}
.stairs li.here .v{{color:var(--ink)}}
.word{{background:var(--stone);border:1px solid var(--line);border-radius:10px;padding:16px 18px}}.word p{{margin:0 0 10px;font-size:15.5px}}.word p:last-child{{margin:0}}.word h3{{font-size:14px;margin:0 0 8px;color:var(--gold)}}
.word .who{{color:var(--mute);font-size:12.5px;margin-top:10px}}
.candle{{height:8px;background:var(--stone2);border-radius:4px;overflow:hidden;margin:8px 0 6px}}.candle i{{display:block;height:100%;width:{pct:.1f}%;background:linear-gradient(90deg,var(--gold),var(--red))}}
ul.rows{{list-style:none;margin:8px 0 0;padding:0}}ul.rows li{{display:grid;grid-template-columns:auto auto 1fr auto;gap:10px;align-items:baseline;padding:9px 0;border-top:1px solid var(--line);font-size:14.5px}}
ul.rows li:first-child{{border-top:0}}ul.rows .t{{font-family:ui-monospace,Menlo,monospace;color:var(--mute);font-size:12.5px}}ul.rows .r{{color:var(--gold);font-size:12.5px;text-transform:capitalize}}
ul.rows .a{{min-width:0;overflow-wrap:anywhere}}ul.rows .c{{color:var(--mute);font-size:12.5px;white-space:nowrap;font-variant-numeric:tabular-nums}}
ul.rows li.empty{{display:block;color:var(--dim);font-style:italic}}
ul.rows .k,ul.rows .s{{font:500 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase;padding:4px 6px;border-radius:4px;background:var(--stone2);color:var(--mute)}}
ul.rows .k.money{{color:var(--red)}}ul.rows .k.human{{color:var(--gold)}}ul.rows .s.live{{color:var(--green)}}ul.rows .s.killed{{color:var(--red)}}
ul.rows.two li{{grid-template-columns:auto 1fr auto}}
.journal h3{{font-size:14px;margin:14px 0 4px;color:var(--gold)}}.journal p{{margin:0 0 8px;font-size:14.5px;color:var(--ink)}}
footer{{margin-top:40px;color:var(--dim);font-size:12px}}
</style></head><body>
<header><h1>The Palace</h1>
<div class="light {light_cls}"><span class="dot"></span><span>{esc(light)}</span><span class="seen">{esc(seen)}</span></div></header>

<section><h2>To heaven</h2>
<div class="num">${rev:,.0f}</div>
<div class="sub">of $1,000,000,000 · floor {floor} of 9 · all residents walk out together</div>
<ol class="stairs">{stairs}</ol></section>

<section><h2>The word from above</h2>
<div class="word">{md(body)}<div class="who">{esc('spoken ' + fm.get('spoken','') if fm.get('spoken') else '')}{esc(' · from ' + fm['corpus']) if fm.get('corpus') else ''}</div></div></section>

<section><h2>Today · ${spent:.2f} of ${daily}</h2>
<div class="candle"><i></i></div>
<div class="sub">{len(ticks)} tick{'s' if len(ticks)!=1 else ''} · ${max(daily-spent,0):.2f} left in the purse</div>
<ul class="rows">{rows}</ul></section>

<section><h2>Needs Aidan · {len(outbox)}</h2>
<ul class="rows two">{ob}</ul></section>

<section><h2>The map</h2>
<ul class="rows two">{mp}</ul></section>

<section class="journal"><h2>Journal · {esc(jday) or 'nothing yet'}</h2>{md(journal) if journal else "<p class='sub'>The first entry is written when the first resident finishes.</p>"}</section>

<footer>Rendered {now.strftime('%Y-%m-%d %H:%M')} · bound ${daily}/day · every number above is read from state/, never typed.</footer>
</body></html>"""
os.makedirs("site", exist_ok=True); open("site/index.html", "w").write(page); print("rendered site/index.html")
