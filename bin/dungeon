#!/bin/zsh
# The loop. launchd keeps this alive; it wakes a resident, breathes, repeats.
# When the laptop sleeps the loop pauses; when it wakes, the loop resumes where
# it was, so the first thing Aidan sees on opening the lid is a tick starting.
cd "$(dirname "$0")/.." || exit 1
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin:$PATH"
LOG=$HOME/Library/Logs/palace.log
echo "=== dungeon up $(date '+%F %T')" >> "$LOG"
while true; do
  /usr/bin/python3 bin/tick >> "$LOG" 2>&1
  mode=$(/usr/bin/python3 -c "import json;print(json.load(open('state/last_tick.json')).get('mode','worked'))" 2>/dev/null)
  case "$mode" in
    ascended) echo "=== HEAVEN $(date '+%F %T')" >> "$LOG"; exit 0 ;;
    dark)     s=$(/usr/bin/python3 -c "import json;print(json.load(open('palace.json'))['cadence']['dark_seconds'])") ;;
    asleep)   s=$(/usr/bin/python3 -c "import json;print(json.load(open('palace.json'))['cadence']['asleep_seconds'])") ;;
    busy)     s=60 ;;
    *)        s=$(/usr/bin/python3 -c "import json;print(json.load(open('palace.json'))['cadence']['breath_seconds'])") ;;
  esac
  sleep "$s"
done
